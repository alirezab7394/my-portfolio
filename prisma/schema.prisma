// Learning tracker schema — progress syncs across devices via Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LEARNING_DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

model TaskProgress {
  id          String     @id @default(cuid())
  taskId      String     @unique
  status      TaskStatus @default(TODO)
  note        String?
  completedAt DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
}

model StudySession {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  minutes   Int
  topic     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
